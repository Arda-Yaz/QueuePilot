* text=auto
*.py text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.csv text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.in text eol=lf
*.lock text eol=lf
Dockerfile text eol=lf
*.sh text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf

# Generated files participate in byte-level model manifests and DVC hashes.
# Preserve their original bytes when checking out on another platform.
artifacts/** -text whitespace=cr-at-eol
reports/** -text whitespace=cr-at-eol
dvc.lock -text whitespace=cr-at-eol
